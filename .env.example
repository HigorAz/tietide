# === Database ===
DATABASE_URL=postgresql://tietide:tietide_secret@localhost:5432/tietide?schema=public
POSTGRES_USER=tietide
POSTGRES_PASSWORD=tietide_secret
POSTGRES_DB=tietide

# === Valkey/Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === API ===
API_PORT=3030
API_HOST=0.0.0.0
NODE_ENV=development

# === Authentication ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT_EXPIRES_IN: access-token lifetime. The token is stored in the SPA's
# localStorage (W4.5 accepted risk), so a SHORTER lifetime limits the window a stolen
# token is usable. Tokens are already revocable server-side via tokenVersion (W1.7:
# POST /v1/auth/logout bumps it). For production prefer a short value (e.g. 1h–24h);
# 7d is a dev convenience. A refresh-token flow to keep short TTLs seamless is a
# planned follow-up.
JWT_EXPIRES_IN=7d

# === Secrets Encryption ===
ENCRYPTION_MASTER_KEY=base64-encoded-32-byte-key-for-libsodium
# ENCRYPTION_MASTER_KEYS_OLD: comma-separated list of PREVIOUS base64 master keys,
# used for DECRYPTION ONLY during a key rotation. New data is always encrypted with
# ENCRYPTION_MASTER_KEY; rows written under an old key keep decrypting via this ring
# until they are re-encrypted. Leave empty when not rotating. See docs/runbook.md.
ENCRYPTION_MASTER_KEYS_OLD=

# === AI Service (Local Model via Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Hosts allowed to bypass the SSRF guard's private/loopback block (worker + API).
# REQUIRED for a self-hosted Ollama connection on a private/loopback address (e.g. the
# OLLAMA_BASE_URL above): without it, ollama-generate/embeddings, the connection health
# check, and the model dropdown's live listing/pull are all refused. Comma-separated
# hostnames, matched case-insensitively against the connection's baseUrl host. Empty =
# strict (no bypass). Only list hosts you trust — they skip the private-range protection.
SSRF_ALLOWED_HOSTS=localhost,127.0.0.1
# Keep the model resident between requests so docs generation skips the ~4.7GB
# CPU cold-load Ollama otherwise pays after its default 5min idle. "-1" = forever.
OLLAMA_KEEP_ALIVE=30m
AI_SERVICE_URL=http://localhost:8000
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=tietide_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
# INTERNAL_AI_TOKEN: shared secret the API sends (X-Internal-Token) and the AI
# service requires on /ingest and /generate-docs. Empty disables the check
# (local dev only); production MUST set the SAME strong value on both apps.
INTERNAL_AI_TOKEN=

# === Worker ===
# WORKER_CONCURRENCY: how many workflow-execution jobs the worker runs in
# parallel. Defaults to 5; invalid/zero/negative values fall back to 5; capped
# at 100. (BullMQ's own default is 1 — leaving this unset previously serialized
# all executions.)
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=5000
# EXECUTION_RETENTION_DAYS: terminal workflow executions (and their steps, via
# cascade) older than this are deleted by a daily retention sweep, keeping the
# executions/steps tables from growing without bound. Defaults to 90; invalid/
# zero/negative values fall back to 90; capped at 3650.
EXECUTION_RETENTION_DAYS=90

# === Observability (metrics) ===
# Prometheus scrape endpoints: API exposes GET /metrics; the worker stands up a
# tiny HTTP server on METRICS_PORT serving /metrics. When METRICS_TOKEN is set,
# both require `Authorization: Bearer <token>` (recommended if the endpoints are
# reachable beyond a trusted network); leave unset to keep them open.
METRICS_TOKEN=
METRICS_PORT=9091

# === SPA ===
# Base URL of the API the SPA will call. MUST include the /v1 prefix — the axios
# client in apps/spa/src/api/client.ts treats VITE_API_URL as a complete baseURL
# and does NOT auto-append /v1, so the URL needs the prefix baked in.
# Example for a deployed instance: VITE_API_URL=https://tietide.example.com/v1
VITE_API_URL=http://localhost:3030/v1
VITE_APP_NAME=TieTide
# Base URL where the connection setup guides live (markdown files in docs/). The SPA
# concatenates this with each provider's setupGuidePath to build a "Setup guide" link
# next to every provider tile. Defaults to the main branch on GitHub if unset.
VITE_DOCS_BASE_URL=https://github.com/HigorAz/tietide/blob/main

# === Logging ===
LOG_LEVEL=debug

# === CORS / Security headers / Swagger ===
# CORS_ORIGIN: SPA origin(s), comma-separated for multiple. MANDATORY in
# production — the API refuses to boot without it (no permissive localhost
# fallback). Defaults to http://localhost:5173 outside production.
CORS_ORIGIN=http://localhost:5173
# SWAGGER_ENABLED: serve Swagger UI at /api/docs. On by default in dev, off by
# default in production (set "true" to expose). HSTS + strict CSP auto-enable
# when NODE_ENV=production.
SWAGGER_ENABLED=true
# TRUST_PROXY: how many reverse-proxy hops to trust for the client IP
# (X-Forwarded-For), so the rate limiter and logs see the real client behind
# the prod tunnel. Use "1" when behind a single proxy. Unset/"false"/"0" =
# disabled. Never set "true" (trust-all) unless every upstream hop is trusted.
TRUST_PROXY=
# BODY_LIMIT: max request body size (express body-parser). Caps memory use from
# oversized payloads. Default 1mb. Inline triggerData is separately capped at
# 64 KiB by the TriggerExecutionDto validator.
BODY_LIMIT=1mb

# === Email (verification) ===
# Registration emails a single-use verification link; the account is activated
# (and auto-logged-in) when the user clicks it. With NO SMTP_HOST set, the API
# uses a LOG transport: it writes the email + link to the logs instead of sending
# — so dev and CI work without a mail server and registration never breaks.
# Set SMTP_HOST (and friends) to enable real delivery in production.
#
# Example — Resend (resend.com; free tier, verify your domain for a custom From):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465            # implicit TLS; use 587 for STARTTLS
#   SMTP_USER=resend         # literally the word "resend"
#   SMTP_PASS=re_xxxxxxxx    # the Resend API key
#   SMTP_FROM=TieTide <no-reply@tietide.com>
#   APP_URL=https://tietide.com
#
# APP_URL: SPA origin used to build the verification link. Falls back to the
# first CORS_ORIGIN, then http://localhost:5173.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true forces TLS; port 465 implies it automatically.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TieTide <no-reply@tietide.local>

# === Webhooks ===
WEBHOOK_BASE_URL=http://localhost:3030/webhooks
WEBHOOK_HMAC_SECRET=your-webhook-hmac-secret

# === Rate Limiting ===
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Per-category named throttlers. Each layers on the default per-user / per-(ip,email)
# bucket and is opt-in per route. Since W5.8 these env values actually drive the
# effective per-route caps (auth endpoints; /workflows/:id/{execute,test} + connection
# test; AI doc generation). Window vars are in milliseconds. Defaults shown.
# THROTTLE_AUTH_TTL_MS=60000
# THROTTLE_AUTH_LIMIT=5
# THROTTLE_EXECUTE_TTL_MS=60000
# THROTTLE_EXECUTE_LIMIT=20
# THROTTLE_AI_TTL_MS=60000
# THROTTLE_AI_LIMIT=3
# Per-IP aggregate throttler (W5.9): an independent IP-only bucket layered on the
# credential routes so one source IP can't rotate the email field to spray a password
# across many accounts. 30/min sits above a single (ip,email) bucket but below the
# global ceiling. Defaults shown.
# THROTTLE_IP_TTL_MS=60000
# THROTTLE_IP_LIMIT=30

# === Feature Flags ===
FEATURE_AI_DOCS_ENABLED=true
FEATURE_CRON_TRIGGERS_ENABLED=true

# === OAuth2 Providers ===
# Where the SPA is hosted. The OAuth callback redirects here on success/error.
SPA_BASE_URL=http://localhost:5173

# Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=google

# Microsoft (defaults to common tenant; override MS_OAUTH_TENANT for single-tenant apps)
# NOTE: no ?provider= query string — Microsoft Entra forbids query strings in redirect
# URIs for apps that support personal Microsoft accounts. The provider is resolved from
# the signed OAuth state JWT instead.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback
MS_OAUTH_TENANT=common

# Slack
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=slack

# Notion
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=notion

# HubSpot
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=hubspot

# GitHub (OAuth App — non-expiring user token, no refresh token).
# GitHub OAuth Apps allow only ONE callback URL each, so TEST and PROD need
# separate OAuth Apps with their own client id/secret. AUTHORIZE/TOKEN URLs only
# need overriding for GitHub Enterprise Server.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=github
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token

# === Meta (Instagram + WhatsApp) OAuth + webhooks ===
# One Meta app backs both Instagram and WhatsApp (Facebook Login). Register the
# redirect URI for BOTH localhost:3031 (TEST) and your prod domain, never :3030.
# instagram_content_publish / whatsapp_business_messaging need Meta App Review +
# business verification before they work for non-test accounts.
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3031/v1/connections/oauth/callback
# Signs inbound webhook deliveries (X-Hub-Signature-256); often == client secret.
META_APP_SECRET=
# Shared secret echoed in the GET ?hub.challenge webhook subscription handshake.
META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v20.0
# META_OAUTH_AUTHORIZE_URL=https://www.facebook.com/v20.0/dialog/oauth
# META_OAUTH_TOKEN_URL=https://graph.facebook.com/v20.0/oauth/access_token

# === AI image generation (AI: Generate Image node) ===
# Pollinations is free + keyless (no var). Hugging Face is an optional token-based
# provider — users supply the token via a `huggingface` connection.
# HUGGINGFACE_INFERENCE_URL=https://api-inference.huggingface.co/models

# === Hosted Ollama (optional) ===
# When set, enables the "Use TieTide's hosted Ollama" connection mode: the API
# injects this URL server-side (client never sends it) and both SSRF guards
# auto-allowlist its host. Distinct from OLLAMA_BASE_URL (the AI service's own).
# OLLAMA_SERVER_BASE_URL=http://ollama:11434

# === Platform billing (Stripe) ===
# PLATFORM Stripe account that bills workspaces (NOT the user-facing Stripe
# workflow nodes). Per-workspace hybrid pricing: a per-seat subscription item +
# a metered (graduated/tiered) usage item for workflow runs. Leave unset to run
# without billing — the billing endpoints report `configured:false` and the SPA
# hides the upgrade/manage actions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids from the Stripe dashboard. *_SEAT_* = per-seat licensed price,
# *_METERED_* = metered usage price (model the included run quota as the $0 tier
# of a graduated price so it stays aligned with PLAN_LIMITS.includedRunsPerPeriod).
STRIPE_PRICE_SEAT_PRO=
STRIPE_PRICE_METERED_PRO=
STRIPE_PRICE_SEAT_BUSINESS=
STRIPE_PRICE_METERED_BUSINESS=
