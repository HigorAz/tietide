# === Database ===
DATABASE_URL=postgresql://tietide:tietide_secret@localhost:5432/tietide?schema=public
POSTGRES_USER=tietide
POSTGRES_PASSWORD=tietide_secret
POSTGRES_DB=tietide

# === Valkey/Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === API ===
API_PORT=3030
API_HOST=0.0.0.0
NODE_ENV=development

# === Authentication ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# === Secrets Encryption ===
ENCRYPTION_MASTER_KEY=base64-encoded-32-byte-key-for-libsodium

# === AI Service (Local Model via Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AI_SERVICE_URL=http://localhost:8000
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=tietide_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
# INTERNAL_AI_TOKEN: shared secret the API sends (X-Internal-Token) and the AI
# service requires on /ingest and /generate-docs. Empty disables the check
# (local dev only); production MUST set the SAME strong value on both apps.
INTERNAL_AI_TOKEN=

# === Worker ===
# WORKER_CONCURRENCY: how many workflow-execution jobs the worker runs in
# parallel. Defaults to 5; invalid/zero/negative values fall back to 5; capped
# at 100. (BullMQ's own default is 1 — leaving this unset previously serialized
# all executions.)
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=5000

# === SPA ===
# Base URL of the API the SPA will call. MUST include the /v1 prefix — the axios
# client in apps/spa/src/api/client.ts treats VITE_API_URL as a complete baseURL
# and does NOT auto-append /v1, so the URL needs the prefix baked in.
# Example for a deployed instance: VITE_API_URL=https://tietide.example.com/v1
VITE_API_URL=http://localhost:3030/v1
VITE_APP_NAME=TieTide
# Base URL where the connection setup guides live (markdown files in docs/). The SPA
# concatenates this with each provider's setupGuidePath to build a "Setup guide" link
# next to every provider tile. Defaults to the main branch on GitHub if unset.
VITE_DOCS_BASE_URL=https://github.com/HigorAz/tietide/blob/main

# === Logging ===
LOG_LEVEL=debug

# === CORS / Security headers / Swagger ===
# CORS_ORIGIN: SPA origin(s), comma-separated for multiple. MANDATORY in
# production — the API refuses to boot without it (no permissive localhost
# fallback). Defaults to http://localhost:5173 outside production.
CORS_ORIGIN=http://localhost:5173
# SWAGGER_ENABLED: serve Swagger UI at /api/docs. On by default in dev, off by
# default in production (set "true" to expose). HSTS + strict CSP auto-enable
# when NODE_ENV=production.
SWAGGER_ENABLED=true
# TRUST_PROXY: how many reverse-proxy hops to trust for the client IP
# (X-Forwarded-For), so the rate limiter and logs see the real client behind
# the prod tunnel. Use "1" when behind a single proxy. Unset/"false"/"0" =
# disabled. Never set "true" (trust-all) unless every upstream hop is trusted.
TRUST_PROXY=

# === Webhooks ===
WEBHOOK_BASE_URL=http://localhost:3030/webhooks
WEBHOOK_HMAC_SECRET=your-webhook-hmac-secret

# === Rate Limiting ===
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# === Feature Flags ===
FEATURE_AI_DOCS_ENABLED=true
FEATURE_CRON_TRIGGERS_ENABLED=true

# === OAuth2 Providers ===
# Where the SPA is hosted. The OAuth callback redirects here on success/error.
SPA_BASE_URL=http://localhost:5173

# Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=google

# Microsoft (defaults to common tenant; override MS_OAUTH_TENANT for single-tenant apps)
# NOTE: no ?provider= query string — Microsoft Entra forbids query strings in redirect
# URIs for apps that support personal Microsoft accounts. The provider is resolved from
# the signed OAuth state JWT instead.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback
MS_OAUTH_TENANT=common

# Slack
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=slack

# Notion
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=notion

# HubSpot
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=hubspot

# GitHub (OAuth App — non-expiring user token, no refresh token).
# GitHub OAuth Apps allow only ONE callback URL each, so TEST and PROD need
# separate OAuth Apps with their own client id/secret. AUTHORIZE/TOKEN URLs only
# need overriding for GitHub Enterprise Server.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3030/v1/connections/oauth/callback?provider=github
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
