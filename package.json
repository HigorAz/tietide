{
  "name": "tietide",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source iPaaS platform for integration & automation",
  "author": "Higor Azevedo",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "ci:build": "turbo run build",
    "ci:test": "turbo run test",
    "loadtest:api": "k6 run infra/load/k6/api-read.js",
    "loadtest:workflow": "k6 run infra/load/k6/workflow-execute.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "msgpackr-extract",
      "bcrypt"
    ],
    "overrides": {
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "lodash@<4.18.0": ">=4.18.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "follow-redirects@<1.16.0": ">=1.16.0",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<14.0.0": ">=14.0.0",
      "fast-uri@<3.1.2": ">=3.1.2",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "qs@>=6.11.1 <6.15.2": ">=6.15.2 <7",
      "js-yaml@>=4.0.0 <4.2.0": ">=4.2.0 <5",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6 <6",
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "react-router@>=6.7.0 <6.30.4": ">=6.30.4 <7",
      "react-router-dom@>=6.7.0 <6.30.4": ">=6.30.4 <7",
      "nodemailer@<=9.0.0": ">=9.0.1 <10",
      "undici@<6.27.0": ">=6.27.0 <7",
      "multer@>=1.0.0 <2.2.0": ">=2.2.0 <3"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.2"
  }
}
