{
  "name": "@tietide/sdk",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.esm.json && node ./scripts/write-type-markers.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@tietide/eslint-config": "workspace:*",
    "eslint": "^9.28.0",
    "typescript": "^6.0.2"
  }
}
