{
  "name": "@tietide/crypto",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.esm.json && node ./scripts/write-type-markers.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "libsodium-wrappers": "^0.8.3"
  },
  "devDependencies": {
    "@tietide/eslint-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.0",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^6.0.2"
  }
}
