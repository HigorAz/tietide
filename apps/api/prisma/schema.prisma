generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  name                  String
  role                  Role     @default(USER)
  tokenVersion          Int      @default(0) @map("token_version")
  emailVerified         Boolean  @default(false) @map("email_verified")
  // The org the SPA opens by default and the fallback when the X-Org-Id header
  // is absent. Nullable so a user mid-deletion of their last org is valid; SetNull.
  defaultOrganizationId String?  @map("default_organization_id")
  // Set when the account is self-deleted. The row is anonymized rather than removed
  // so authored workflows/secrets/audit logs (Restrict FKs) keep their integrity;
  // the auth path (login + JWT strategy) rejects any user with deletedAt set.
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workflows               Workflow[]
  secrets                 Secret[]
  connections             Connection[]
  auditLogs               AuditLog[]
  workflowVersions        WorkflowVersion[]
  environmentVariables    EnvironmentVariable[]
  folders                 Folder[]
  tags                    Tag[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  organizationMemberships OrganizationMember[]
  createdOrganizations    Organization[]           @relation("OrgCreatedBy")
  defaultOrganization     Organization?            @relation("UserDefaultOrg", fields: [defaultOrganizationId], references: [id], onDelete: SetNull)

  @@map("users")
}

// Single-use, hashed email-verification tokens. The raw token is emailed to the
// user; only its SHA-256 hash is stored, so a DB leak cannot be used to verify
// accounts. Consumed (single-use) and expiry-bounded — mirrors the OAuthState
// anti-replay pattern (W2.1).
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// Single-use, hashed password-reset tokens. Same design as the email-verification
// tokens: the raw token is emailed, only its SHA-256 hash is stored, single-use
// (consumedAt) and short-lived (1h). Consuming one sets the new password, bumps
// tokenVersion (revoking existing sessions), and marks the email verified.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum Role {
  USER
  ADMIN
}

// Organization (workspace) roles. SUPERADMIN is the all-powerful top tier and may
// be held by MULTIPLE members (it is NOT a single owner pointer) — permission
// derives from a member's role only. Rank: SUPERADMIN > ADMIN > MEMBER > VIEWER.
enum OrgRole {
  SUPERADMIN
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  // Audit-only record of who created the org — NOT a permission source. SetNull so
  // deleting the creating user does not delete the org.
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy            User?                 @relation("OrgCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  defaultForUsers      User[]                @relation("UserDefaultOrg")
  members              OrganizationMember[]
  invites              OrganizationInvite[]
  workflows            Workflow[]
  secrets              Secret[]
  connections          Connection[]
  folders              Folder[]
  tags                 Tag[]
  environmentVariables EnvironmentVariable[]
  auditLogs            AuditLog[]
  subscription         Subscription?

  @@map("organizations")
}

// Per-workspace billing plan. The workspace is the billing entity; its owner
// (SUPERADMIN) pays. Hybrid pricing: per-seat subscription + metered runs above
// an included quota. One row per Organization (provisioned at create time, FREE).
// Plan LIMITS live in @tietide/shared PLAN_LIMITS; Stripe is the billing source
// of truth for paid plans — webhooks keep this row in sync.
enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique @map("organization_id")
  plan                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  // Stripe price ids for the seat (licensed) and metered (usage) line items, and
  // the metered subscription_item id usage records are reported against.
  seatPriceId          String?            @map("seat_price_id")
  meteredPriceId       String?            @map("metered_price_id")
  meteredSubItemId     String?            @map("metered_sub_item_id")
  // Purchased seat quantity (kept in sync with member count for paid plans).
  seats                Int                @default(1)
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  // High-water mark: the `created` timestamp of the most recently applied Stripe
  // event. Out-of-order / retried webhooks older than this are ignored so a stale
  // subscription.updated can't re-elevate a workspace already cancelled by a newer
  // subscription.deleted (W5.17).
  lastStripeEventAt    DateTime?          @map("last_stripe_event_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// Idempotency ledger for Stripe webhook delivery. Every event id is recorded once;
// a retried delivery hits the unique constraint and is short-circuited as already
// processed, so handlers never run twice (W5.17).
model ProcessedStripeEvent {
  id         String   @id @default(uuid())
  eventId    String   @unique @map("event_id")
  type       String?
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("processed_stripe_events")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Single-use, hashed organization invites. The raw token is emailed; only its
// SHA-256 hash is stored — mirrors EmailVerificationToken (W2.1). Consuming one
// (single-use, expiry-bounded) creates an OrganizationMember with `role`.
model OrganizationInvite {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  role           OrgRole   @default(MEMBER)
  tokenHash      String    @unique @map("token_hash")
  invitedById    String?   @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@map("organization_invites")
}

enum EnvVarScope {
  GLOBAL
  USER
}

model EnvironmentVariable {
  id             String      @id @default(uuid())
  scope          EnvVarScope
  userId         String?     @map("user_id")
  // Set for USER-scope rows (workspace-shared vars); NULL for GLOBAL platform vars.
  organizationId String?     @map("organization_id")
  key            String
  valueEnc       String      @map("value_enc")
  valueNonce     String      @map("value_nonce")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Uniqueness is enforced by two partial unique indexes (scope-specific) in the
  // migration. Postgres treats NULL as distinct in standard unique indexes, so a
  // composite @@unique here would NOT prevent duplicate GLOBAL rows. USER-scope
  // uniqueness is partitioned by organization_id (workspace-shared), not user_id.
  @@index([scope])
  @@map("environment_variables")
}

model Workflow {
  id             String   @id @default(uuid())
  name           String
  description    String?
  definition     Json
  isActive       Boolean  @default(false) @map("is_active")
  version        Int      @default(1)
  // Owning workspace. `userId` is retained as the creator/author.
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  folderId       String?  @map("folder_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id])
  folder                Folder?                @relation(fields: [folderId], references: [id], onDelete: Cascade)
  executions            WorkflowExecution[]
  webhooks              Webhook[]
  documentation         WorkflowDocumentation?
  versions              WorkflowVersion[]
  tags                  WorkflowTag[]
  providerSubscriptions ProviderSubscription[]
  triggerCursors        TriggerCursor[]

  @@index([organizationId, folderId])
  @@index([userId, folderId])
  // Worker cron/poll schedulers sweep all active workflows globally
  // (where { isActive: true }) — index it so that scan does not table-scan.
  @@index([isActive])
  @@map("workflows")
}

model Folder {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  name           String
  parentFolderId String?  @map("parent_folder_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Folder?      @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children     Folder[]     @relation("FolderTree")
  workflows    Workflow[]

  @@index([organizationId, parentFolderId])
  @@index([userId, parentFolderId])
  @@map("folders")
}

model Tag {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  name           String
  color          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflows    WorkflowTag[]

  // Tag names are unique per workspace (not per user).
  @@unique([organizationId, name])
  @@map("tags")
}

model WorkflowTag {
  workflowId String   @map("workflow_id")
  tagId      String   @map("tag_id")
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workflowId, tagId])
  @@index([tagId])
  @@map("workflow_tags")
}

model WorkflowVersion {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  version     Int
  definition  Json
  message     String?
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id")

  workflow  Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@unique([workflowId, version])
  @@index([workflowId, createdAt(sort: Desc)])
  @@map("workflow_versions")
}

model WorkflowDocumentation {
  id            String   @id @default(uuid())
  workflowId    String   @unique @map("workflow_id")
  version       Int
  documentation String
  sections      Json
  model         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_documentation")
}

model WorkflowExecution {
  id                String          @id @default(uuid())
  workflowId        String          @map("workflow_id")
  parentExecutionId String?         @map("parent_execution_id")
  status            ExecutionStatus @default(PENDING)
  triggerType       String          @map("trigger_type")
  triggerData       Json?           @map("trigger_data")
  idempotencyKey    String?         @map("idempotency_key")
  isDryRun          Boolean         @default(false) @map("is_dry_run")
  startedAt         DateTime?       @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  error             String?
  createdAt         DateTime        @default(now()) @map("created_at")

  workflow        Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  parentExecution WorkflowExecution?  @relation("ParentChild", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  childExecutions WorkflowExecution[] @relation("ParentChild")
  steps           ExecutionStep[]

  @@unique([workflowId, idempotencyKey], name: "workflow_idempotency_key")
  @@index([workflowId, createdAt(sort: Desc)])
  @@index([parentExecutionId])
  @@map("workflow_executions")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  SKIPPED
}

model ExecutionStep {
  id          String          @id @default(uuid())
  executionId String          @map("execution_id")
  nodeId      String          @map("node_id")
  nodeType    String          @map("node_type")
  nodeName    String          @map("node_name")
  status      ExecutionStatus @default(PENDING)
  inputData   Json?           @map("input_data")
  outputData  Json?           @map("output_data")
  error       String?
  startedAt   DateTime?       @map("started_at")
  finishedAt  DateTime?       @map("finished_at")
  durationMs  Int?            @map("duration_ms")

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_steps")
}

model Secret {
  id             String   @id @default(uuid())
  name           String
  value          String
  nonce          String
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  // Secret names are unique per workspace (not per user).
  @@unique([organizationId, name])
  @@map("secrets")
}

model Connection {
  id                    String           @id @default(uuid())
  organizationId        String           @map("organization_id")
  userId                String           @map("user_id")
  type                  ConnectionType
  provider              String
  name                  String
  status                ConnectionStatus @default(ACTIVE)
  configEncrypted       String           @map("config_encrypted")
  configNonce           String           @map("config_nonce")
  refreshTokenEncrypted String?          @map("refresh_token_encrypted")
  refreshTokenNonce     String?          @map("refresh_token_nonce")
  expiresAt             DateTime?        @map("expires_at")
  lastUsedAt            DateTime?        @map("last_used_at")
  refreshFailureCount   Int              @default(0) @map("refresh_failure_count")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@index([userId, provider])
  // OAuth refresh-scan sweeps connections due for refresh
  // (where { status: ACTIVE, expiresAt: { lt: cutoff } }).
  @@index([status, expiresAt])
  @@map("connections")
}

enum ConnectionType {
  OAUTH2
  API_KEY
  BASIC_AUTH
  BEARER_TOKEN
  CUSTOM
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  ERROR
  REVOKED
}

model Webhook {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  path       String   @unique
  hmacSecret String   @map("hmac_secret")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model AuditLog {
  id             String   @id @default(uuid())
  // Owning workspace. Nullable for pre-org / account-level events (e.g. auth) that
  // are not scoped to a workspace.
  organizationId String?  @map("organization_id")
  userId         String   @map("user_id")
  action         String
  resource       String
  resourceId     String?  @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  // Backs the (non-org-scoped) SELECT DISTINCT action / resource sweeps in
  // AuditLogService.listFilterValues — avoids a full table scan of audit_logs.
  @@index([action, resource])
  @@map("audit_logs")
}

model ProviderSubscription {
  id            String    @id @default(uuid())
  workflowId    String    @map("workflow_id")
  nodeId        String    @map("node_id")
  provider      String
  providerSubId String    @map("provider_sub_id")
  secretEnc     String    @map("secret_enc")
  secretNonce   String    @map("secret_nonce")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, nodeId])
  @@index([workflowId])
  @@index([expiresAt])
  @@map("provider_subscriptions")
}

model TriggerCursor {
  workflowId   String   @map("workflow_id")
  nodeId       String   @map("node_id")
  cursor       String
  lastPolledAt DateTime @default(now()) @map("last_polled_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@id([workflowId, nodeId])
  @@map("trigger_cursors")
}

// Short-lived server-side state for the OAuth Authorization Code + PKCE flow.
// Written at /oauth/start, consumed exactly once at /oauth/callback. Holds the
// PKCE code_verifier (never sent to the browser) and enforces single-use of the
// state nonce (jti) so a captured callback URL cannot be replayed.
model OAuthState {
  jti          String    @id
  userId       String    @map("user_id")
  provider     String
  codeVerifier String    @map("code_verifier")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}
